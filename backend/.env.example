BETTER_ENGLISH_APP_NAME=Better English AI
BETTER_ENGLISH_DOCS_ENABLED=true
# Required for tutoring; optional for backend startup. Never commit a real key.
# BETTER_ENGLISH_GLM__API_KEY=
BETTER_ENGLISH_GLM__MODEL=glm-5.3-flash
BETTER_ENGLISH_GLM__TIMEOUT_SECONDS=60
BETTER_ENGLISH_GLM__API_URL=https://api.z.ai/api/paas/v4/chat/completions
BETTER_ENGLISH_GLM__MAX_RESPONSE_TOKENS=2048
BETTER_ENGLISH_GLM__REASONING_EFFORT=low
BETTER_ENGLISH_GLM__MAX_INPUT_CHARACTERS=20000
BETTER_ENGLISH_GLM__MAX_HISTORY_MESSAGES=10
BETTER_ENGLISH_AUDIO__DEVICE=cpu
BETTER_ENGLISH_AUDIO__MODELS_DIRECTORY=data/models
# Optional existing local checkpoint; otherwise use the models directory above.
# BETTER_ENGLISH_PARAKEET__MODEL_PATH=/absolute/path/parakeet-tdt-0.6b-v3.nemo
BETTER_ENGLISH_PARAKEET__CPU_THREADS=4
BETTER_ENGLISH_PARAKEET__MAX_AUDIO_BYTES=10485760
BETTER_ENGLISH_PARAKEET__MAX_DURATION_SECONDS=60
# Defaults use data/models/pocket-tts/config.yaml and alba.safetensors.
# BETTER_ENGLISH_POCKET_TTS__CONFIG_PATH=/absolute/path/config.yaml
# BETTER_ENGLISH_POCKET_TTS__VOICE_PATH=/absolute/path/alba.safetensors
BETTER_ENGLISH_POCKET_TTS__CPU_THREADS=1
BETTER_ENGLISH_POCKET_TTS__MAX_TEXT_CHARACTERS=2000
# OpenPronounce uses CPU and local Piper reference speech.
BETTER_ENGLISH_OPENPRONOUNCE__CPU_THREADS=2
BETTER_ENGLISH_OPENPRONOUNCE__MAX_AUDIO_BYTES=10485760
BETTER_ENGLISH_OPENPRONOUNCE__MAX_DURATION_SECONDS=60
BETTER_ENGLISH_OPENPRONOUNCE__MAX_TEXT_CHARACTERS=2000
# Optional upstream settings: OPENPRONOUNCE_TTS_VOICE=en_GB-cori-medium
# HF_HUB_OFFLINE=1 after the Wav2Vec2 models and Piper voice are cached.
# Voice conversation: optional pronunciation must not delay every turn.
BETTER_ENGLISH_CONVERSATION__PRONUNCIATION_ENABLED=true
BETTER_ENGLISH_CONVERSATION__PRONUNCIATION_TIMEOUT_SECONDS=5
